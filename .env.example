# ─────────────────────────────────────────────────────────────
# Configuración general del servidor WebSocket
# ─────────────────────────────────────────────────────────────
# IMPORTANTE: 0.0.0.0 permite que otras computadoras de la red entren usando la IP del servidor.
HOST=0.0.0.0
PORT=3000
SERVER_ID=server-1

# ─────────────────────────────────────────────────────────────
# Base de datos compartida
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatdb
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5432/chatdb

# ─────────────────────────────────────────────────────────────
# Redis para comunicación entre varios servidores
# ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=chat_redis_password
REDIS_URL=redis://:chat_redis_password@localhost:6379
# Canal Redis para sincronizar eventos entre servidores. Debe ser IGUAL en todos los servidores.
REDIS_CHANNEL=chat:events

# ─────────────────────────────────────────────────────────────
# Historial y seguridad básica
# ─────────────────────────────────────────────────────────────
# Guarda/carga los últimos 300 mensajes por canal o conversación.
MAX_HISTORY=300
MAX_MESSAGE_LENGTH=300

# Límite para evitar spam: 30 mensajes cada 10 segundos por conexión.
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=30

# Ping/pong para detectar conexiones muertas.
HEARTBEAT_INTERVAL_MS=30000

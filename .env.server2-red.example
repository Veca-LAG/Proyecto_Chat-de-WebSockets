# ─────────────────────────────────────────────────────────────
# Configuración para la computadora B (servidor remoto)
# Copia este archivo como .env en la computadora B y cambia la IP.
# La computadora A es la que tiene Docker con PostgreSQL y Redis.
# ─────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=3001
SERVER_ID=server-2

# Apunta a la IP de la computadora A en tu red local.
# Ejemplo: si ipconfig en la PC A muestra 192.168.1.100, usa esa IP.
DATABASE_URL=postgresql://chatuser:chatpass@192.168.137.1:5432/chatdb

REDIS_URL=redis://:chat_redis_password@192.168.137.1:6379

# IMPORTANTE: REDIS_CHANNEL debe ser EXACTAMENTE el mismo en ambas computadoras.
REDIS_CHANNEL=chat:events

MAX_HISTORY=300
MAX_MESSAGE_LENGTH=300
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=30
HEARTBEAT_INTERVAL_MS=30000
